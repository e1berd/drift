{
  "$id": "https://drift.local/schemas/identity.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Drift user",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email",
          "maxLength": 320,
          "ory.sh/kratos": {
            "credentials": {
              "password": {
                "identifier": true
              },
              "passkey": {
                "display_name": true
              }
            }
          }
        },
        "name": {
          "type": "string",
          "title": "Name",
          "maxLength": 200
        }
      },
      "required": ["email"],
      "additionalProperties": false
    }
  }
}
