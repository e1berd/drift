{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "vue"],
  "rules": {
    "func-style": [
      "error",
      "declaration",
      {
        "allowArrowFunctions": true
      }
    ],
    "object-shorthand": ["error", "always"],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "typescript/consistent-type-imports": [
      "error",
      {
        "prefer": "type-imports",
        "fixStyle": "separate-type-imports"
      }
    ],
    "typescript/no-import-type-side-effects": "error",
    "vue/define-emits-declaration": ["error", "type-literal"],
    "vue/valid-define-emits": "error",
    "unicorn/prefer-at": [
      "error",
      {
        "checkAllIndexAccess": true
      }
    ],
    "unicorn/prefer-array-flat": "error",
    "unicorn/prefer-array-flat-map": "error",
    "unicorn/prefer-string-replace-all": "error",
    "unicorn/prefer-object-from-entries": "error",
    "prefer-object-has-own": "error",
    "unicorn/prefer-structured-clone": "error"
  },
  "ignorePatterns": [
    "packages/sdk/src/api/types/**",
    "packages/sdk/src/api/clients/**",
    "packages/vue/src/api/queries/**",
    "**/dist/**"
  ],
  "overrides": [
    {
      "files": ["packages/sdk/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(vue|vue-.*|@vue/.*|@ui-sdk/.*|@tanstack/.*|@/.*|@drift/vue(/.*)?)$",
                "message": "@drift/sdk stays framework-agnostic so any Drift interface can reuse it."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/vue/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(@ui-sdk/.*|@phosphor-icons/.*|@/.*)$",
                "message": "@drift/vue holds no look: every Drift front end on Vue reuses it with its own UI kit."
              }
            ]
          }
        ]
      }
    }
  ]
}
