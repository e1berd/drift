{
  "name": "drift-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @drift/app-default dev",
    "build": "run-p types:check \"build-only {@}\" --",
    "build-only": "pnpm --filter @drift/app-default build-only",
    "preview": "pnpm --filter @drift/app-default preview",
    "test:unit": "vitest",
    "test:e2e": "pnpm --filter @drift/app-default test:e2e",
    "types:check": "vue-tsc --build",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "generate": "KUBB_DISABLE_TELEMETRY=1 kubb generate && node scripts/link-api-packages.mjs"
  },
  "devDependencies": {
    "@kubb/adapter-oas": "5.21.1",
    "@kubb/plugin-client": "6.1.1",
    "@kubb/plugin-ts": "5.5.5",
    "@kubb/plugin-vue-query": "5.10.5",
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^30.0.1",
    "kubb": "5.21.1",
    "lefthook": "2.2.2",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.79.0",
    "oxlint": "1.94.0",
    "typescript": "~6.0.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
